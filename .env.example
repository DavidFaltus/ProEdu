# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_CLIENT_ID: Required for Google Calendar integration using Google Identity Services.
# Users configure this via the Secrets panel in the AI Studio UI.
VITE_GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID"

# VITE_FIREBASE_MEASUREMENT_ID: Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Bank account details for QR payments (SPAYD standard)
BANK_ACCOUNT_NUMBER="2100000000"
BANK_CODE="2010"
BANK_NAME="Fio banka"
BANK_RECIPIENT="ProEdu vzdělávání"

# Comgate Payment Gateway Configuration
COMGATE_MERCHANT_ID=""
COMGATE_SECRET=""
COMGATE_TEST_MODE="true"

# iÚčto REST API v1.3 Configuration (server-only, NEVER prefix with VITE_)
IUCTO_API_KEY=""
IUCTO_API_BASE_URL="https://online.iucto.cz/api/1.3"
# Set to "true" ONLY when testing against a dedicated Start trial company in iÚčto
IUCTO_SANDBOX_ENABLED="false"
# Optional: explicit ID of the Comgate bank account in iÚčto (auto-detected if empty)
IUCTO_COMGATE_BANK_ACCOUNT_ID=""
# Optional: set to "true" to automatically account issued documents in iÚčto journal
IUCTO_AUTO_ACCOUNT="false"
# Optional: secret header for scheduled subscription renewal webhook
CRON_SECRET=""

# E-mailová komunikace (SMTP / Gmail / Vlastní doména)
# Pro Gmail zadejte SMTP_USER="vas-email@gmail.com" a do SMTP_PASS vygenerujte Google App Password (Heslo aplikace)
# Pro vlastní doménu (např. info@pro-edu.eu) zadejte SMTP server vašeho hostingu
# Pokud zůstanou prázdné, server běží v Dev režimu a kódy/e-maily vypisuje do konzole
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ProEdu <info@pro-edu.eu>"
