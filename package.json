{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "start": "node server/index.js",
    "dev:api": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy --only hosting,functions",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "lint": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:rules": "firebase emulators:exec --only firestore,storage \"tsx --test test/p0FirestoreRulesEmulator.test.ts test/p1RulesAndStorageEmulator.test.ts test/p2RulesAndSchemaEmulator.test.ts\"",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:apk": "npm run cap:sync && cd android && gradlew assembleDebug",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "simulate:order": "node scripts/simulate-order-flow.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@comgate/checkout-js": "^3.0.17",
    "@fontsource-variable/geist": "^5.2.8",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.17",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^11.0.1",
    "katex": "^0.19.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.4.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "read-excel-file": "^9.3.20",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
