rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS (Custom Claims Only — Zero Email / Firestore Fallbacks)
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isTeacher() {
      return isAuthenticated() && (
        (('role' in request.auth.token) && request.auth.token.role == 'teacher') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         userDoc().data.role == 'teacher')
      );
    }

    // Legacy alias kept for backward compatibility in static rule checks
    function isAdmin() {
      return isTeacher();
    }

    function isPaidUser() {
      return isAuthenticated() && (
        (('role' in request.auth.token) &&
         request.auth.token.role in ['premium', 'course', 'teacher']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         userDoc().data.role in ['premium', 'course', 'teacher'])
      );
    }

    // Required exact function name referenced by unit tests
    function isPremiumOrAdmin() {
      return isPaidUser();
    }

    function isEnrolledInCourse(courseId) {
      return isTeacher() || (
        isAuthenticated() &&
        courseId is string &&
        courseId.size() > 0 && (
          ('enrolledCourseIds' in request.auth.token &&
           request.auth.token.enrolledCourseIds is list &&
           courseId in request.auth.token.enrolledCourseIds) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           'enrolledCourseIds' in userDoc().data &&
           userDoc().data.enrolledCourseIds is list &&
           courseId in userDoc().data.enrolledCourseIds)
        )
      );
    }

    // deleteField()-safe immutability check
    function unchanged(field) {
      return (!(field in resource.data) && !(field in request.resource.data)) ||
        ((field in resource.data) &&
         (field in request.resource.data) &&
         request.resource.data[field] == resource.data[field]);
    }

    function hasNoImmutableChanges(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function keepsImmutableFields() {
      return unchanged('uid') &&
        unchanged('createdAt') &&
        unchanged('createdBy') &&
        unchanged('studentId') &&
        unchanged('testId') &&
        unchanged('referredBy') &&
        hasNoImmutableChanges(['uid', 'createdAt', 'createdBy', 'studentId', 'testId', 'referredBy']);
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) ||
        data[field] == null ||
        (data[field] is string && data[field].size() <= maxLen);
    }

    function isOptionalNumber(data, field, minVal, maxVal) {
      return !(field in data) ||
        data[field] == null ||
        (data[field] is number && data[field] >= minVal && data[field] <= maxVal);
    }

    function isOptionalBool(data, field) {
      return !(field in data) || data[field] == null || data[field] is bool;
    }

    function isTimestampOrString(val) {
      return val is timestamp || val is string;
    }

    function isOptionalTimestampOrString(data, field) {
      return !(field in data) || data[field] == null || isTimestampOrString(data[field]);
    }

    function isNotHidden(data) {
      return !('isHidden' in data) || data.isHidden != true;
    }

    // =========================================================================
    // SCHEMA VALIDATORS
    // =========================================================================

    function isValidBillingDetails(billing) {
      return billing is map &&
        billing.keys().hasOnly([
          'clientName', 'invoiceEmail', 'street', 'city', 'zip', 'country', 'ico', 'dic'
        ]) &&
        isOptionalString(billing, 'clientName', 128) &&
        isOptionalString(billing, 'invoiceEmail', 256) &&
        isOptionalString(billing, 'street', 150) &&
        isOptionalString(billing, 'city', 100) &&
        isOptionalString(billing, 'zip', 20) &&
        isOptionalString(billing, 'country', 64) &&
        isOptionalString(billing, 'ico', 20) &&
        isOptionalString(billing, 'dic', 20);
    }

    function isValidUserCreate(data, userId) {
      return data.keys().hasOnly([
          'uid', 'email', 'name', 'displayName', 'photoURL',
          'avatarEmoji', 'avatarBgColor', 'role', 'jokers', 'streak',
          'dailyVideosWatched', 'lastDailyGrantDate', 'lastJokerResetDate',
          'lastViewedActivityAt', 'notificationsReadAt', 'referralCode',
          'referralsCount', 'focusAreas', 'year', 'targetSchool', 'goalGrade',
          'weeklyGoal', 'dailyGoalMinutes', 'preferredDifficulty',
          'onboardingCompleted', 'createdAt', 'updatedAt'
        ]) &&
        !data.keys().hasAny([
          'enrolledCourseIds', 'courseId', 'subscriptionStatus',
          'subscriptionPeriodEnd', 'subscriptionExpiresAt', 'subscriptionExpiredAt',
          'subscriptionCancelledAt', 'subscriptionCancelReason',
          'initRecurringTransId', 'recurringCancelled', 'recurringCancelledAt',
          'pendingOrderId', 'isAdmin', 'referredBy',
          'surveyCompleted', 'surveyAnswer', 'surveyCustomAnswer', 'surveySubmittedAt',
          'iuctoCustomerId', 'lastRecurringAttemptDate', 'lastRecurringOrderId',
          'lastRecurringPaymentFailed', 'lastRecurringFailureReason', 'lastRecurringFailedAt',
          'xp', 'gardenPlants',
          'focusSessionsHistory', 'lastPracticeDate', 'lastStreakPracticeDate',
          'premiumSince', 'cancelledOrderIds'
        ]) &&
        data.uid == userId &&
        data.role == 'free' &&
        data.jokers == 5 &&
        data.streak == 0 &&
        (!('dailyVideosWatched' in data) || data.dailyVideosWatched == 0) &&
        (!('referralsCount' in data) || data.referralsCount == 0) &&
        (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 320)) &&
        isOptionalString(data, 'name', 128) &&
        isOptionalString(data, 'displayName', 128) &&
        isOptionalString(data, 'photoURL', 500000) &&
        isOptionalString(data, 'avatarEmoji', 16) &&
        isOptionalString(data, 'avatarBgColor', 32) &&
        isOptionalString(data, 'referralCode', 32) &&
        isOptionalString(data, 'lastDailyGrantDate', 32) &&
        isOptionalString(data, 'lastJokerResetDate', 32) &&
        isOptionalString(data, 'targetSchool', 128) &&
        isOptionalString(data, 'goalGrade', 32) &&
        (!('year' in data) || data.year == null ||
          (data.year is int && data.year >= 1 && data.year <= 13) ||
          (data.year is string && data.year.size() <= 32)) &&
        isOptionalNumber(data, 'weeklyGoal', 0, 1000) &&
        isOptionalNumber(data, 'dailyGoalMinutes', 0, 1440) &&
        (!('preferredDifficulty' in data) || data.preferredDifficulty == null ||
          data.preferredDifficulty in ['easy', 'medium', 'hard', 'adaptive']) &&
        isOptionalBool(data, 'onboardingCompleted') &&
        (!('focusAreas' in data) || (data.focusAreas is list && data.focusAreas.size() <= 30)) &&
        ('createdAt' in data && isTimestampOrString(data.createdAt)) &&
        isOptionalTimestampOrString(data, 'updatedAt') &&
        isOptionalTimestampOrString(data, 'lastViewedActivityAt') &&
        isOptionalTimestampOrString(data, 'notificationsReadAt');
    }

    function isValidUserProfileOwnerUpdate(data) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'name', 'photoURL', 'avatarEmoji', 'avatarBgColor',
          'year', 'targetSchool', 'goalGrade', 'weeklyGoal', 'dailyGoalMinutes',
          'preferredDifficulty', 'onboardingCompleted', 'updatedAt', 'focusAreas',
          'notificationsReadAt', 'lastViewedActivityAt', 'billingDetails',
          'preferredPaymentMethod'
        ]) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'uid', 'email', 'createdAt', 'role', 'enrolledCourseIds', 'courseId',
          'jokers', 'dailyVideosWatched', 'lastJokerReset', 'lastJokerResetDate',
          'lastDailyGrantDate', 'streak', 'lastPracticeDate', 'lastStreakPracticeDate',
          'xp', 'subscriptionStatus', 'subscriptionPeriodEnd', 'subscriptionExpiresAt',
          'subscriptionExpiredAt', 'subscriptionCancelledAt', 'subscriptionCancelReason',
          'initRecurringTransId', 'recurringCancelled', 'recurringCancelledAt',
          'pendingOrderId', 'referredBy', 'referralsCount',
          'referralCode', 'surveyCompleted', 'surveyAnswer', 'surveyCustomAnswer',
          'surveySubmittedAt', 'gardenPlants', 'focusSessionsHistory', 'isAdmin',
          'iuctoCustomerId', 'lastRecurringAttemptDate', 'lastRecurringOrderId',
          'lastRecurringPaymentFailed', 'lastRecurringFailureReason', 'lastRecurringFailedAt',
          'premiumSince'
        ]) &&
        isOptionalString(data, 'displayName', 128) &&
        isOptionalString(data, 'name', 128) &&
        isOptionalString(data, 'photoURL', 500000) &&
        isOptionalString(data, 'avatarEmoji', 16) &&
        isOptionalString(data, 'avatarBgColor', 32) &&
        isOptionalString(data, 'targetSchool', 128) &&
        isOptionalString(data, 'goalGrade', 32) &&
        (!('year' in data) || data.year == null ||
          (data.year is int && data.year >= 1 && data.year <= 13) ||
          (data.year is string && data.year.size() <= 32)) &&
        isOptionalNumber(data, 'weeklyGoal', 0, 1000) &&
        isOptionalNumber(data, 'dailyGoalMinutes', 0, 1440) &&
        (!('preferredDifficulty' in data) || data.preferredDifficulty == null ||
          data.preferredDifficulty in ['easy', 'medium', 'hard', 'adaptive']) &&
        isOptionalBool(data, 'onboardingCompleted') &&
        (!('focusAreas' in data) || (data.focusAreas is list && data.focusAreas.size() <= 30)) &&
        (!('preferredPaymentMethod' in data) || data.preferredPaymentMethod == null ||
          data.preferredPaymentMethod == 'comgate') &&
        (!('billingDetails' in data) || data.billingDetails == null ||
          isValidBillingDetails(data.billingDetails)) &&
        isOptionalTimestampOrString(data, 'updatedAt') &&
        isOptionalTimestampOrString(data, 'notificationsReadAt') &&
        isOptionalTimestampOrString(data, 'lastViewedActivityAt');
    }

    function isValidTopic(data) {
      return data.keys().hasOnly([
          'id', 'name', 'title', 'subjectId', 'description',
          'icon', 'color', 'order', 'isHidden',
          'createdAt', 'createdBy', 'updatedAt'
        ]) &&
        (('name' in data && isNonEmptyString(data.name, 200)) ||
         ('title' in data && isNonEmptyString(data.title, 200))) &&
        isOptionalString(data, 'name', 200) &&
        isOptionalString(data, 'title', 200) &&
        isNonEmptyString(data.subjectId, 128) &&
        isOptionalString(data, 'description', 2000) &&
        isOptionalString(data, 'icon', 64) &&
        isOptionalString(data, 'color', 32) &&
        isOptionalNumber(data, 'order', -1000, 10000) &&
        isOptionalBool(data, 'isHidden') &&
        isOptionalString(data, 'createdBy', 128) &&
        isOptionalTimestampOrString(data, 'createdAt') &&
        isOptionalTimestampOrString(data, 'updatedAt');
    }

    function isValidSubject(data) {
      return data.keys().hasOnly([
          'id', 'name', 'title', 'description', 'icon', 'color',
          'order', 'isHidden', 'createdAt', 'createdBy', 'updatedAt'
        ]) &&
        (('name' in data && isNonEmptyString(data.name, 200)) ||
         ('title' in data && isNonEmptyString(data.title, 200))) &&
        isOptionalString(data, 'description', 2000) &&
        isOptionalString(data, 'icon', 64) &&
        isOptionalString(data, 'color', 32) &&
        isOptionalNumber(data, 'order', -1000, 10000) &&
        isOptionalBool(data, 'isHidden') &&
        isOptionalString(data, 'createdBy', 128) &&
        isOptionalTimestampOrString(data, 'createdAt') &&
        isOptionalTimestampOrString(data, 'updatedAt');
    }

    function isValidPracticeSubtopic(data) {
      return data.keys().hasOnly([
          'id', 'title', 'topicId', 'topic', 'subjectId', 'description',
          'order', 'isHidden', 'hasStudyMaterial', 'materialId', 'pairedMaterialId',
          'fileUrl', 'pdfUrl', 'downloadUrl', 'thumbnailUrl', 'fileType',
          'originalName', 'svgUrl', 'svgContent', 'studyTheory', 'studySteps',
          'studyTips', 'studyImages', 'studyVideos', 'sampleProblem',
          'practiceConfig', 'createdAt', 'createdBy', 'updatedAt'
        ]) &&
        isNonEmptyString(data.title, 256) &&
        isNonEmptyString(data.topicId, 128) &&
        isNonEmptyString(data.subjectId, 128) &&
        isOptionalString(data, 'topic', 200) &&
        isOptionalString(data, 'description', 2000) &&
        isOptionalNumber(data, 'order', -1000, 10000) &&
        isOptionalBool(data, 'isHidden') &&
        isOptionalBool(data, 'hasStudyMaterial') &&
        isOptionalString(data, 'materialId', 128) &&
        isOptionalString(data, 'pairedMaterialId', 128) &&
        isOptionalString(data, 'fileUrl', 5000) &&
        isOptionalString(data, 'pdfUrl', 5000) &&
        isOptionalString(data, 'downloadUrl', 5000) &&
        isOptionalString(data, 'thumbnailUrl', 500000) &&
        isOptionalString(data, 'fileType', 128) &&
        isOptionalString(data, 'originalName', 256) &&
        isOptionalString(data, 'svgUrl', 5000) &&
        isOptionalString(data, 'svgContent', 1000000) &&
        isOptionalString(data, 'studyTheory', 200000) &&
        (!('studySteps' in data) || data.studySteps == null ||
          (data.studySteps is list && data.studySteps.size() <= 50)) &&
        (!('studyTips' in data) || data.studyTips == null ||
          data.studyTips is string || data.studyTips is list) &&
        (!('studyImages' in data) || data.studyImages == null ||
          (data.studyImages is list && data.studyImages.size() <= 50)) &&
        (!('studyVideos' in data) || data.studyVideos == null ||
          (data.studyVideos is list && data.studyVideos.size() <= 20)) &&
        (!('sampleProblem' in data) || data.sampleProblem == null ||
          data.sampleProblem is map || data.sampleProblem is string) &&
        (!('practiceConfig' in data) || data.practiceConfig == null ||
          data.practiceConfig is map) &&
        isOptionalString(data, 'createdBy', 128) &&
        isOptionalTimestampOrString(data, 'createdAt') &&
        isOptionalTimestampOrString(data, 'updatedAt');
    }

    function isValidQuestion(data) {
      return data.keys().hasOnly([
          'id', 'question', 'type', 'correctAnswer', 'options', 'hint',
          'explanation', 'difficulty', 'subjectId', 'topicId', 'topic',
          'subtopicId', 'imageUrl', 'svgContent', 'solutionImageUrl',
          'solutionSvgContent', 'caseSensitive', 'order', 'isHidden',
          'createdAt', 'createdBy', 'updatedAt'
        ]) &&
        isNonEmptyString(data.question, 5000) &&
        isNonEmptyString(data.subtopicId, 128) &&
        (data.type in ['multiple_choice', 'choice', 'open', 'text', 'numeric', 'math'] ||
         data.type == 'self_check') &&
        (data.correctAnswer is string && data.correctAnswer.size() <= 5000) &&
        (!('options' in data) || data.options == null ||
          (data.options is list && data.options.size() <= 20)) &&
        isOptionalString(data, 'hint', 2000) &&
        isOptionalString(data, 'explanation', 10000) &&
        (!('difficulty' in data) || data.difficulty == null ||
          data.difficulty in [
            'easy', 'medium', 'hard',
            'Lehká', 'Střední', 'Těžká',
            'Začátečník', 'Středně pokročilý', 'Pokročilý'
          ]) &&
        isOptionalString(data, 'subjectId', 128) &&
        isOptionalString(data, 'topicId', 128) &&
        isOptionalString(data, 'topic', 200) &&
        isOptionalString(data, 'imageUrl', 600000) &&
        isOptionalString(data, 'svgContent', 500000) &&
        (!('solutionImageUrl' in data) || data.solutionImageUrl == null ||
          (data.solutionImageUrl is string && data.solutionImageUrl.size() <= 600000)) &&
        (!('solutionSvgContent' in data) || data.solutionSvgContent == null ||
          (data.solutionSvgContent is string && data.solutionSvgContent.size() <= 500000)) &&
        isOptionalBool(data, 'caseSensitive') &&
        isOptionalNumber(data, 'order', -1000, 10000) &&
        isOptionalBool(data, 'isHidden') &&
        isOptionalString(data, 'createdBy', 128) &&
        isOptionalTimestampOrString(data, 'createdAt') &&
        isOptionalTimestampOrString(data, 'updatedAt');
    }

    function isValidLearningSheet(data) {
      return data.keys().hasOnly([
          'id', 'title', 'subject', 'subjectId', 'topic', 'topicId', 'subtopicId',
          'studyTheory', 'content', 'studySteps', 'hiddenFromLibrary', 'isHidden',
          'materialType', 'grade', 'order', 'pageCount', 'isFreeSample', 'isExamPrep',
          'activeChunkPrefix',
          'status', 'errorMessage', 'originalName', 'fileType', 'fileSize',
          'thumbnailUrl', 'fileUrl', 'pdfUrl', 'svgUrl', 'downloadUrl',
          'hasStudyMaterial', 'hasThumbnailChunk', 'chunkCount', 'chunkedPdf',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isNonEmptyString(data.title, 256) &&
        isOptionalString(data, 'subject', 128) &&
        isOptionalString(data, 'subjectId', 128) &&
        isOptionalString(data, 'topic', 200) &&
        isOptionalString(data, 'topicId', 128) &&
        isOptionalString(data, 'subtopicId', 128) &&
        isOptionalString(data, 'studyTheory', 200000) &&
        isOptionalString(data, 'content', 1000000) &&
        (!('studySteps' in data) || data.studySteps == null ||
          (data.studySteps is list && data.studySteps.size() <= 50)) &&
        isOptionalBool(data, 'hiddenFromLibrary') &&
        isOptionalBool(data, 'isHidden') &&
        (!('materialType' in data) || data.materialType == null ||
          data.materialType in ['worksheet', 'summary', 'cheatsheet']) &&
        (!('grade' in data) || data.grade == null ||
          data.grade in ['5', '7', '9', 'all']) &&
        isOptionalNumber(data, 'order', -1000, 10000) &&
        isOptionalNumber(data, 'pageCount', 0, 500) &&
        isOptionalBool(data, 'isFreeSample') &&
        isOptionalBool(data, 'isExamPrep') &&
        isOptionalString(data, 'activeChunkPrefix', 128) &&
        (!('status' in data) || data.status == null ||
          data.status in ['processing', 'ready', 'error']) &&
        isOptionalString(data, 'errorMessage', 1000) &&
        isOptionalString(data, 'originalName', 256) &&
        isOptionalString(data, 'fileType', 128) &&
        isOptionalNumber(data, 'fileSize', 0, 50000000) &&
        isOptionalString(data, 'thumbnailUrl', 500000) &&
        isOptionalString(data, 'fileUrl', 5000) &&
        isOptionalString(data, 'pdfUrl', 5000) &&
        isOptionalString(data, 'svgUrl', 5000) &&
        isOptionalString(data, 'downloadUrl', 5000) &&
        isOptionalBool(data, 'hasStudyMaterial') &&
        isOptionalBool(data, 'hasThumbnailChunk') &&
        isOptionalNumber(data, 'chunkCount', 0, 500) &&
        isOptionalBool(data, 'chunkedPdf') &&
        isOptionalString(data, 'createdBy', 128) &&
        isOptionalTimestampOrString(data, 'createdAt') &&
        isOptionalTimestampOrString(data, 'updatedAt');
    }

    function isValidStudyProgress(data, userId, subtopicId) {
      return data.keys().hasOnly([
          'uid', 'subtopicId', 'completedSteps', 'verifiedAnswers',
          'totalSteps', 'createdAt', 'updatedAt'
        ]) &&
        data.uid == userId &&
        data.subtopicId == subtopicId &&
        data.completedSteps is list &&
        data.completedSteps.size() <= 100 &&
        (!('verifiedAnswers' in data) || data.verifiedAnswers == null || data.verifiedAnswers is map) &&
        isOptionalNumber(data, 'totalSteps', 0, 100) &&
        isOptionalTimestampOrString(data, 'createdAt') &&
        isOptionalTimestampOrString(data, 'updatedAt');
    }

    function isValidLearningSheetChunk(data) {
      return data.keys().hasOnly([
          'data', 'contentType', 'index', 'total', 'createdAt'
        ]) &&
        isNonEmptyString(data.data, 1040000) &&
        isOptionalString(data, 'contentType', 128) &&
        isOptionalNumber(data, 'index', 0, 1000) &&
        isOptionalNumber(data, 'total', 1, 1000) &&
        isOptionalTimestampOrString(data, 'createdAt');
    }

    function isValidCourse(data) {
      return data.keys().hasOnly([
          'id', 'title', 'description', 'subject', 'price', 'difficulty',
          'schedule', 'instructorName', 'startDate', 'endDate', 'badge', 'color',
          'meetUrl', 'syllabus', 'teacherId', 'studentIds', 'studentCount',
          'isHidden', 'category', 'duration', 'lessonsCount',
          'createdAt', 'createdBy', 'updatedAt'
        ]) &&
        isNonEmptyString(data.title, 200) &&
        isOptionalString(data, 'description', 5000) &&
        isOptionalString(data, 'subject', 128) &&
        isOptionalNumber(data, 'price', 0, 500000) &&
        isOptionalString(data, 'difficulty', 64) &&
        isOptionalString(data, 'schedule', 512) &&
        isOptionalString(data, 'instructorName', 128) &&
        isOptionalString(data, 'startDate', 64) &&
        isOptionalString(data, 'endDate', 64) &&
        isOptionalString(data, 'badge', 64) &&
        isOptionalString(data, 'color', 32) &&
        isOptionalString(data, 'meetUrl', 1000) &&
        (!('syllabus' in data) || data.syllabus == null ||
          (data.syllabus is list && data.syllabus.size() <= 100) ||
          (data.syllabus is string && data.syllabus.size() <= 10000)) &&
        isOptionalString(data, 'teacherId', 128) &&
        (!('studentIds' in data) || data.studentIds == null ||
          (data.studentIds is list && data.studentIds.size() <= 2000)) &&
        isOptionalNumber(data, 'studentCount', 0, 2000) &&
        isOptionalBool(data, 'isHidden') &&
        isOptionalString(data, 'category', 128) &&
        isOptionalString(data, 'duration', 128) &&
        isOptionalNumber(data, 'lessonsCount', 0, 500) &&
        isOptionalString(data, 'createdBy', 128) &&
        isOptionalTimestampOrString(data, 'createdAt') &&
        isOptionalTimestampOrString(data, 'updatedAt');
    }

    function isValidCourseItem(data) {
      return data.keys().hasOnly([
          'courseId', 'title', 'description', 'type', 'order', 'url', 'fileUrl',
          'meetUrl', 'materialId', 'subtopicId', 'content', 'isHidden',
          'dueDate', 'scheduledAt', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isNonEmptyString(data.courseId, 128) &&
        isNonEmptyString(data.title, 256) &&
        isOptionalString(data, 'description', 5000) &&
        isOptionalString(data, 'type', 64) &&
        isOptionalNumber(data, 'order', -1000, 10000) &&
        isOptionalString(data, 'url', 5000) &&
        isOptionalString(data, 'fileUrl', 5000) &&
        isOptionalString(data, 'meetUrl', 1000) &&
        isOptionalString(data, 'materialId', 128) &&
        isOptionalString(data, 'subtopicId', 128) &&
        isOptionalString(data, 'content', 100000) &&
        isOptionalBool(data, 'isHidden') &&
        isOptionalTimestampOrString(data, 'dueDate') &&
        isOptionalTimestampOrString(data, 'scheduledAt') &&
        isOptionalString(data, 'createdBy', 128) &&
        isOptionalTimestampOrString(data, 'createdAt') &&
        isOptionalTimestampOrString(data, 'updatedAt');
    }

    function isValidLiveLesson(data) {
      return data.keys().hasOnly([
          'title', 'description', 'subject', 'teacherId', 'teacherName',
          'provider', 'meetUrl', 'scheduledAt', 'durationMinutes', 'status',
          'targetAudience', 'studentIds', 'courseId', 'studentId',
          'createdAt', 'updatedAt'
        ]) &&
        isNonEmptyString(data.title, 200) &&
        isOptionalString(data, 'description', 2000) &&
        isOptionalString(data, 'subject', 128) &&
        isNonEmptyString(data.teacherId, 128) &&
        isOptionalString(data, 'teacherName', 128) &&
        isNonEmptyString(data.provider, 64) &&
        isNonEmptyString(data.meetUrl, 1000) &&
        data.meetUrl.matches('^https?://.*') &&
        ('scheduledAt' in data && isTimestampOrString(data.scheduledAt)) &&
        data.durationMinutes is number &&
        data.durationMinutes >= 5 &&
        data.durationMinutes <= 480 &&
        data.status in ['scheduled', 'live', 'ended', 'completed', 'cancelled'] &&
        data.targetAudience in ['all', 'individual', 'selected', 'course'] &&
        (!('studentIds' in data) || data.studentIds == null ||
          (data.studentIds is list && data.studentIds.size() <= 1000)) &&
        (!('courseId' in data) || data.courseId == null ||
          (isNonEmptyString(data.courseId, 128) && data.targetAudience == 'course')) &&
        (!('studentId' in data) || data.studentId == null ||
          (isNonEmptyString(data.studentId, 128) && data.targetAudience != 'all')) &&
        isOptionalTimestampOrString(data, 'createdAt') &&
        isOptionalTimestampOrString(data, 'updatedAt');
    }

    function isValidAssignedTest(data) {
      return data.keys().hasOnly([
          'studentId', 'studentName', 'teacherId', 'createdBy', 'testId',
          'title', 'description', 'subjectId', 'topicId', 'subtopicId',
          'questions', 'answers', 'status', 'grade', 'score', 'maxScore',
          'feedback', 'dueDate', 'assignedAt', 'startedAt', 'submittedAt',
          'gradedAt', 'timeSpentSeconds', 'createdAt', 'updatedAt'
        ]) &&
        isNonEmptyString(data.studentId, 128) &&
        isOptionalString(data, 'studentName', 128) &&
        isOptionalString(data, 'teacherId', 128) &&
        isOptionalString(data, 'createdBy', 128) &&
        isOptionalString(data, 'testId', 128) &&
        isNonEmptyString(data.title, 256) &&
        isOptionalString(data, 'description', 5000) &&
        isOptionalString(data, 'subjectId', 128) &&
        isOptionalString(data, 'topicId', 128) &&
        isOptionalString(data, 'subtopicId', 128) &&
        (!('questions' in data) || data.questions == null ||
          (data.questions is list && data.questions.size() <= 200)) &&
        (!('answers' in data) || data.answers == null ||
          data.answers is map || data.answers is list) &&
        data.status in ['assigned', 'in_progress', 'submitted', 'graded'] &&
        (!('grade' in data) || data.grade == null ||
          data.grade is string || data.grade is number) &&
        isOptionalNumber(data, 'score', 0, 10000) &&
        isOptionalNumber(data, 'maxScore', 0, 10000) &&
        isOptionalString(data, 'feedback', 5000) &&
        isOptionalTimestampOrString(data, 'dueDate') &&
        isOptionalTimestampOrString(data, 'assignedAt') &&
        isOptionalTimestampOrString(data, 'startedAt') &&
        isOptionalTimestampOrString(data, 'submittedAt') &&
        isOptionalTimestampOrString(data, 'gradedAt') &&
        isOptionalNumber(data, 'timeSpentSeconds', 0, 86400) &&
        isOptionalTimestampOrString(data, 'createdAt') &&
        isOptionalTimestampOrString(data, 'updatedAt');
    }

    // Required exact function name & shape referenced by test/activePracticeSessions.test.ts
    function isValidActivePracticeSession(data) {
      return data.keys().hasOnly([
          'studentId', 'userId', 'subtopicId', 'topicId', 'subjectId',
          'questionIds', 'currentIndex', 'answeredCount', 'totalCount',
          'answersMap', 'openInputs', 'showHintMap', 'bookmarkedIndices',
          'updatedAt', 'createdAt'
        ]) &&
        !data.keys().hasAny([
          'pointsEarned', 'score', 'grade', 'feedback', 'isCompleted', 'completedAt'
        ]) &&
        data.studentId == request.auth.uid &&
        (!('userId' in data) || data.userId == request.auth.uid) &&
        isNonEmptyString(data.subtopicId, 128) &&
        isOptionalString(data, 'topicId', 128) &&
        isOptionalString(data, 'subjectId', 128) &&
        data.questionIds is list && data.questionIds.size() <= 100 &&
        data.currentIndex is number && data.currentIndex >= 0 && data.currentIndex <= 100 &&
        data.answeredCount is number && data.answeredCount >= 0 && data.answeredCount <= 100 &&
        data.totalCount is number && data.totalCount >= 0 && data.totalCount <= 100 &&
        data.answersMap is map &&
        (!('openInputs' in data) || data.openInputs is map) &&
        (!('showHintMap' in data) || data.showHintMap is map) &&
        (!('bookmarkedIndices' in data) ||
          (data.bookmarkedIndices is list && data.bookmarkedIndices.size() <= 100)) &&
        isOptionalTimestampOrString(data, 'updatedAt') &&
        isOptionalTimestampOrString(data, 'createdAt');
    }

    function isValidBugReport(data) {
      return data.keys().hasOnly([
          'userId', 'userEmail', 'userName', 'category', 'categoryLabel',
          'description', 'pageUrl', 'screenshotUrl', 'userAgent',
          'screenResolution', 'status', 'resolutionNotes', 'resolvedAt',
          'resolvedBy', 'createdAt', 'updatedAt'
        ]) &&
        isNonEmptyString(data.userId, 128) &&
        isOptionalString(data, 'userEmail', 320) &&
        isOptionalString(data, 'userName', 128) &&
        data.category in ['question', 'technical', 'visual', 'improvement', 'other'] &&
        isOptionalString(data, 'categoryLabel', 64) &&
        isNonEmptyString(data.description, 5000) &&
        isOptionalString(data, 'pageUrl', 1000) &&
        isOptionalString(data, 'screenshotUrl', 2000) &&
        isOptionalString(data, 'userAgent', 512) &&
        isOptionalString(data, 'screenResolution', 64) &&
        data.status in ['pending', 'new', 'in_progress', 'resolved'] &&
        isOptionalString(data, 'resolutionNotes', 2000) &&
        isOptionalTimestampOrString(data, 'resolvedAt') &&
        isOptionalString(data, 'resolvedBy', 128) &&
        ('createdAt' in data && isTimestampOrString(data.createdAt)) &&
        isOptionalTimestampOrString(data, 'updatedAt');
    }

    function isValidQuestionInquiry(data) {
      return data.keys().hasOnly([
          'studentId', 'studentName', 'questionId', 'questionText', 'topic',
          'comment', 'status', 'isReadByStudent', 'senderRole', 'reply',
          'teacherReply', 'repliedAt', 'repliedBy', 'repliedByName',
          'createdAt', 'updatedAt'
        ]) &&
        isNonEmptyString(data.studentId, 128) &&
        isOptionalString(data, 'studentName', 128) &&
        isOptionalString(data, 'questionId', 128) &&
        isOptionalString(data, 'questionText', 5000) &&
        isOptionalString(data, 'topic', 256) &&
        isNonEmptyString(data.comment, 2000) &&
        data.status in ['pending', 'answered'] &&
        isOptionalBool(data, 'isReadByStudent') &&
        (!('senderRole' in data) || data.senderRole in ['student', 'teacher']) &&
        isOptionalString(data, 'reply', 5000) &&
        isOptionalString(data, 'teacherReply', 5000) &&
        isOptionalTimestampOrString(data, 'repliedAt') &&
        isOptionalString(data, 'repliedBy', 128) &&
        isOptionalString(data, 'repliedByName', 128) &&
        ('createdAt' in data && isTimestampOrString(data.createdAt)) &&
        isOptionalTimestampOrString(data, 'updatedAt');
    }

    function isValidTodo(data) {
      return data.keys().hasOnly([
          'studentId', 'userId', 'title', 'description', 'type', 'completed',
          'addedBy', 'createdAt', 'dueDate', 'completedAt', 'updatedAt',
          'referenceId', 'subjectId', 'topicId', 'planId',
          'repetitionIndex', 'totalRepetitions'
        ]) &&
        isNonEmptyString(data.studentId, 128) &&
        isOptionalString(data, 'userId', 128) &&
        isNonEmptyString(data.title, 256) &&
        isOptionalString(data, 'description', 2000) &&
        data.type in ['practice', 'lesson', 'course_lesson', 'custom', 'test'] &&
        data.completed is bool &&
        isNonEmptyString(data.addedBy, 128) &&
        isOptionalTimestampOrString(data, 'createdAt') &&
        isOptionalTimestampOrString(data, 'dueDate') &&
        isOptionalTimestampOrString(data, 'completedAt') &&
        isOptionalTimestampOrString(data, 'updatedAt') &&
        isOptionalString(data, 'referenceId', 128) &&
        isOptionalString(data, 'subjectId', 128) &&
        isOptionalString(data, 'topicId', 128) &&
        isOptionalString(data, 'planId', 128) &&
        isOptionalNumber(data, 'repetitionIndex', 1, 500) &&
        isOptionalNumber(data, 'totalRepetitions', 1, 500);
    }

    // =========================================================================
    // COLLECTION RULES
    // =========================================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isTeacher();
      allow create: if (isOwner(userId) && isValidUserCreate(request.resource.data, userId)) ||
        (isTeacher() &&
         request.resource.data.uid == userId &&
         request.resource.data.role in ['free', 'student', 'premium', 'course', 'teacher']);
      allow update: if (isTeacher() &&
          unchanged('uid') &&
          (!('role' in request.resource.data) ||
           request.resource.data.role in ['free', 'student', 'premium', 'course', 'teacher'])) ||
        (isOwner(userId) && isValidUserProfileOwnerUpdate(request.resource.data));
      allow delete: if isTeacher();

      match /materialQuotas/{periodKey} {
        allow read: if isOwner(userId) || isTeacher();
        allow write: if false;
      }

      match /studyProgress/{subtopicId} {
        allow read: if isOwner(userId) || isTeacher();
        allow create: if isOwner(userId) &&
          isValidStudyProgress(request.resource.data, userId, subtopicId);
        allow update: if isOwner(userId) &&
          unchanged('uid') &&
          unchanged('subtopicId') &&
          unchanged('createdAt') &&
          isValidStudyProgress(request.resource.data, userId, subtopicId);
        allow delete: if isOwner(userId) || isTeacher();
      }
    }

    match /questions/{qId} {
      allow read: if isAuthenticated();
      allow create: if isTeacher() && isValidQuestion(request.resource.data);
      allow update: if isTeacher() &&
        keepsImmutableFields() &&
        isValidQuestion(request.resource.data);
      allow delete: if isTeacher();
    }

    match /practiceTopics/{topicId} {
      allow read: if true;
      allow create: if isTeacher() && isValidTopic(request.resource.data);
      allow update: if isTeacher() &&
        unchanged('createdAt') &&
        unchanged('createdBy') &&
        isValidTopic(request.resource.data);
      allow delete: if isTeacher();
    }

    match /customTopics/{topicId} {
      allow read: if true;
      allow create: if isTeacher() && isValidTopic(request.resource.data);
      allow update: if isTeacher() &&
        unchanged('createdAt') &&
        unchanged('createdBy') &&
        isValidTopic(request.resource.data);
      allow delete: if isTeacher();
    }

    match /customSubjects/{subjectId} {
      allow read: if true;
      allow create: if isTeacher() && isValidSubject(request.resource.data);
      allow update: if isTeacher() &&
        unchanged('createdAt') &&
        unchanged('createdBy') &&
        isValidSubject(request.resource.data);
      allow delete: if isTeacher();
    }

    // Unpaid users fetch sanitized catalog via /api/practice/catalog (strips theory/media)
    match /practiceSubtopics/{subtopicId} {
      allow read: if true;
      allow create: if isTeacher() && isValidPracticeSubtopic(request.resource.data);
      allow update: if isTeacher() &&
        unchanged('createdAt') &&
        unchanged('createdBy') &&
        isValidPracticeSubtopic(request.resource.data);
      allow delete: if isTeacher();
    }

    match /learningSheets/{sheetId} {
      allow read: if isTeacher();
      allow create: if isTeacher() && isValidLearningSheet(request.resource.data);
      allow update: if isTeacher() &&
        unchanged('createdAt') &&
        unchanged('createdBy') &&
        isValidLearningSheet(request.resource.data);
      allow delete: if isTeacher();

      match /chunks/{chunkId} {
        allow read: if isTeacher();
        allow create: if isTeacher() && isValidLearningSheetChunk(request.resource.data);
        allow update: if isTeacher() &&
          unchanged('createdAt') &&
          isValidLearningSheetChunk(request.resource.data);
        allow delete: if isTeacher();
      }
    }

    match /studyMaterials/{materialId} {
      allow read: if isTeacher() || isPaidUser();
      allow create: if isTeacher() && isValidLearningSheet(request.resource.data);
      allow update: if isTeacher() &&
        unchanged('createdAt') &&
        unchanged('createdBy') &&
        isValidLearningSheet(request.resource.data);
      allow delete: if isTeacher();
    }

    // Unenrolled / public users browse sanitized courses catalog via /api/courses
    match /courses/{courseId} {
      allow read: if isTeacher() || isEnrolledInCourse(courseId);
      allow create: if isTeacher() && isValidCourse(request.resource.data);
      allow update: if isTeacher() &&
        unchanged('createdAt') &&
        unchanged('createdBy') &&
        isValidCourse(request.resource.data);
      allow delete: if isTeacher();
    }

    match /practiceCourses/{courseId} {
      allow read: if isTeacher() || isEnrolledInCourse(courseId);
      allow create: if isTeacher() && isValidCourse(request.resource.data);
      allow update: if isTeacher() &&
        unchanged('createdAt') &&
        unchanged('createdBy') &&
        isValidCourse(request.resource.data);
      allow delete: if isTeacher();
    }

    match /courseItems/{itemId} {
      allow read: if isTeacher() || (
        ('courseId' in resource.data) &&
        isEnrolledInCourse(resource.data.courseId) &&
        isNotHidden(resource.data)
      );
      allow create: if isTeacher() && isValidCourseItem(request.resource.data);
      allow update: if isTeacher() &&
        unchanged('createdAt') &&
        unchanged('createdBy') &&
        isValidCourseItem(request.resource.data);
      allow delete: if isTeacher();
    }

    match /liveLessons/{lessonId} {
      allow read: if isTeacher() || (isAuthenticated() && (
        ('targetAudience' in resource.data &&
         resource.data.targetAudience == 'all' &&
         isPaidUser()) ||
        ('studentIds' in resource.data &&
         resource.data.studentIds != null &&
         request.auth.uid in resource.data.studentIds) ||
        ('studentId' in resource.data &&
         resource.data.studentId == request.auth.uid) ||
        ('courseId' in resource.data &&
         resource.data.courseId != null &&
         isEnrolledInCourse(resource.data.courseId))
      ));
      allow create: if isTeacher() &&
        request.resource.data.teacherId == request.auth.uid &&
        isValidLiveLesson(request.resource.data);
      allow update: if isTeacher() &&
        (!('teacherId' in resource.data) || resource.data.teacherId == request.auth.uid) &&
        unchanged('teacherId') &&
        unchanged('createdAt') &&
        isValidLiveLesson(request.resource.data);
      allow delete: if isTeacher();
    }

    // Practice test results written strictly by Admin SDK (/api/practice/finish)
    match /tests/{testId} {
      allow read: if isTeacher() || (isAuthenticated() && (
        ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
        ('studentId' in resource.data && resource.data.studentId == request.auth.uid)
      ));
      allow create, update, delete: if false;
    }

    match /assignedTests/{testId} {
      allow read: if isTeacher() ||
        (isAuthenticated() &&
         resource.data.studentId == request.auth.uid &&
         resource.data.status in ['submitted', 'graded']);
      allow create: if isTeacher() && isValidAssignedTest(request.resource.data);
      allow update: if (
          isTeacher() &&
          unchanged('createdAt') &&
          unchanged('createdBy') &&
          unchanged('studentId') &&
          unchanged('testId') &&
          isValidAssignedTest(request.resource.data)
        ) || (
          isAuthenticated() &&
          resource.data.studentId == request.auth.uid &&
          resource.data.status in ['assigned', 'in_progress'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'answers', 'status', 'submittedAt', 'startedAt', 'updatedAt', 'timeSpentSeconds'
          ]) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'grade', 'feedback', 'gradedAt', 'studentId', 'teacherId', 'testId',
            'title', 'questions', 'maxScore', 'score', 'createdBy', 'createdAt'
          ]) &&
          request.resource.data.status in ['in_progress', 'submitted'] &&
          isValidAssignedTest(request.resource.data)
        );
      allow delete: if isTeacher();
    }

    match /activePracticeSessions/{sessionId} {
      allow read: if isTeacher() || (isAuthenticated() && (
        ('studentId' in resource.data && resource.data.studentId == request.auth.uid) ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid)
      ));
      allow create: if isAuthenticated() && isValidActivePracticeSession(request.resource.data);
      allow update: if isAuthenticated() &&
        ('studentId' in resource.data && resource.data.studentId == request.auth.uid) &&
        keepsImmutableFields() &&
        unchanged('subtopicId') &&
        unchanged('userId') &&
        isValidActivePracticeSession(request.resource.data);
      allow delete: if isTeacher() || (isAuthenticated() && (
        ('studentId' in resource.data && resource.data.studentId == request.auth.uid) ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid)
      ));
    }

    match /practiceAttempts/{attemptId} {
      allow read: if isTeacher() || (isAuthenticated() && (
        ('studentId' in resource.data && resource.data.studentId == request.auth.uid) ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid)
      ));
      allow create, update, delete: if false;
    }

    match /focusSessions/{sessionId} {
      allow read: if isTeacher() || (isAuthenticated() && (
        ('studentId' in resource.data && resource.data.studentId == request.auth.uid) ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid)
      ));
      allow create, update, delete: if false;
    }

    // Orders managed strictly via Admin SDK (/api/orders/*, /api/payments/*)
    match /orders/{orderId} {
      allow read: if isTeacher() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /surveyResponses/{responseId} {
      allow read: if isTeacher() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /referrals/{referralId} {
      allow read: if isTeacher() || (isAuthenticated() && (
        ('referrerUid' in resource.data && resource.data.referrerUid == request.auth.uid) ||
        ('refereeUid' in resource.data && resource.data.refereeUid == request.auth.uid)
      ));
      allow write: if false;
    }

    match /bugReports/{reportId} {
      allow read: if isTeacher() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status in ['pending', 'new'] &&
        (!('resolutionNotes' in request.resource.data) || request.resource.data.resolutionNotes == null) &&
        (!('resolvedAt' in request.resource.data) || request.resource.data.resolvedAt == null) &&
        (!('resolvedBy' in request.resource.data) || request.resource.data.resolvedBy == null) &&
        isValidBugReport(request.resource.data);
      allow update: if isTeacher() &&
        unchanged('userId') &&
        unchanged('createdAt') &&
        isValidBugReport(request.resource.data);
      allow delete: if isTeacher();
    }

    match /questionInquiries/{inquiryId} {
      allow read: if isTeacher() ||
        (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create: if (
          isTeacher() && isValidQuestionInquiry(request.resource.data)
        ) || (
          isAuthenticated() &&
          request.resource.data.studentId == request.auth.uid &&
          request.resource.data.status == 'pending' &&
          (!('senderRole' in request.resource.data) || request.resource.data.senderRole == 'student') &&
          (!('isReadByStudent' in request.resource.data) || request.resource.data.isReadByStudent == false) &&
          (!('reply' in request.resource.data) || request.resource.data.reply == null) &&
          (!('teacherReply' in request.resource.data) || request.resource.data.teacherReply == null) &&
          (!('repliedAt' in request.resource.data) || request.resource.data.repliedAt == null) &&
          (!('repliedBy' in request.resource.data) || request.resource.data.repliedBy == null) &&
          (!('repliedByName' in request.resource.data) || request.resource.data.repliedByName == null) &&
          isValidQuestionInquiry(request.resource.data)
        );
      allow update: if (
          isTeacher() &&
          unchanged('studentId') &&
          unchanged('createdAt') &&
          isValidQuestionInquiry(request.resource.data)
        ) || (
          isAuthenticated() &&
          resource.data.studentId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isReadByStudent']) &&
          request.resource.data.isReadByStudent == true
        );
      allow delete: if isTeacher();
    }

    match /todos/{todoId} {
      allow read: if isTeacher() || (isAuthenticated() && (
        ('studentId' in resource.data && resource.data.studentId == request.auth.uid) ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid)
      ));
      allow create: if (
          isTeacher() ||
          (isAuthenticated() &&
           request.resource.data.studentId == request.auth.uid &&
           request.resource.data.addedBy == request.auth.uid &&
           request.resource.data.completed == false &&
           (request.resource.data.type != 'practice' || isPremiumOrAdmin()))
        ) && isValidTodo(request.resource.data);
      allow update: if isValidTodo(request.resource.data) &&
        (!('studentId' in resource.data) || unchanged('studentId')) &&
        (!('userId' in resource.data) || unchanged('userId')) &&
        (!('addedBy' in resource.data) || unchanged('addedBy')) &&
        (!('createdAt' in resource.data) || unchanged('createdAt')) &&
        (!('type' in resource.data) || unchanged('type')) && (
          isTeacher() ||
          (isOwner(resource.data.studentId) &&
           resource.data.addedBy == request.auth.uid &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'dueDate', 'completed', 'completedAt'])) ||
          (isOwner(resource.data.studentId) &&
           resource.data.addedBy != request.auth.uid &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completed', 'completedAt']))
        );
      allow delete: if isTeacher() ||
        (isOwner(resource.data.studentId) && resource.data.addedBy == request.auth.uid);
    }

    // Backend-only operational & audit collections (never readable/writable from clients)
    match /pendingRegistrations/{regId} {
      allow read, write: if false;
    }

    match /counters/{docId} {
      allow read, write: if false;
    }

    match /webhooks/{docId} {
      allow read, write: if false;
    }

    match /cronLocks/{docId} {
      allow read, write: if false;
    }

    match /emailLogs/{logId} {
      allow read: if isTeacher();
      allow write: if false;
    }

    // Deny-all fallback for any unmodeled collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
